# ---- Compose: all overlays merged; profiles decide what actually starts ----
COMPOSE_PROJECT_NAME=lakehouse
COMPOSE_FILE=docker-compose.yml:compose/sources.yml:compose/ingestion.yml:compose/storage.yml
# ---- Secrets (dev). Move to Vault in the ops phase ----
POSTGRES_PASSWORD=change-me-pg
# optional per-DB overrides (default = POSTGRES_PASSWORD): PG_AIRFLOW_PASSWORD, PG_KEYCLOAK_PASSWORD, ...
PG_ICEBERG_PASSWORD=change-me-iceberg
MSSQL_SA_PASSWORD=Str0ng-Passw0rd-1
S3_ACCESS_KEY=lakeadmin
S3_SECRET_KEY=change-me-s3-secret-key
S3_REGION=us-east-1
S3_ENDPOINT=http://s3:8333
S3_BUCKET=lake
CLICKHOUSE_USER=lake
CLICKHOUSE_PASSWORD=change-me-ch
NIFI_PASSWORD=change-me-nifi-12chars
NIFI_SENSITIVE_KEY=change-me-sensitive-key
# ---- Image versions: pin and verify tags before first pull ----
POSTGRES_VERSION=16
MSSQL_VERSION=2022-latest
KAFKA_VERSION=3.8.0
DEBEZIUM_VERSION=3.0.0.Final
APICURIO_VERSION=2.6.2.Final
NIFI_VERSION=2.12.0
SEAWEEDFS_VERSION=latest
CLICKHOUSE_VERSION=25.8
ICEBERG_REST_VERSION=1.6.0
