{
  "title": "LakeHouse Overview",
  "uid": "lakehouse-overview",
  "timezone": "utc",
  "refresh": "1m",
  "time": { "from": "now-6h", "to": "now" },
  "panels": [
    {
      "type": "stat",
      "title": "Prometheus up",
      "gridPos": { "x": 0, "y": 0, "w": 4, "h": 4 },
      "targets": [{ "expr": "up{job=\"prometheus\"}" }]
    },
    {
      "type": "stat",
      "title": "Trino up",
      "gridPos": { "x": 4, "y": 0, "w": 4, "h": 4 },
      "targets": [{ "expr": "up{job=\"trino\"}" }]
    },
    {
      "type": "stat",
      "title": "StarRocks FE up",
      "gridPos": { "x": 8, "y": 0, "w": 4, "h": 4 },
      "targets": [{ "expr": "up{job=\"starrocks-fe\"}" }]
    },
    {
      "type": "stat",
      "title": "OpenMetadata up",
      "gridPos": { "x": 12, "y": 0, "w": 4, "h": 4 },
      "targets": [{ "expr": "up{job=\"openmetadata\"}" }]
    },
    {
      "type": "stat",
      "title": "Ceph RGW up",
      "gridPos": { "x": 16, "y": 0, "w": 4, "h": 4 },
      "targets": [{ "expr": "up{job=\"ceph-rgw\"}" }]
    },
    {
      "type": "logs",
      "title": "Container logs (Loki)",
      "gridPos": { "x": 0, "y": 4, "w": 24, "h": 12 },
      "datasource": { "type": "loki", "uid": "loki" },
      "targets": [
        { "expr": "{container=~\"lakehouse-.*\"}", "refId": "A" }
      ]
    }
  ],
  "schemaVersion": 39,
  "version": 1
}
